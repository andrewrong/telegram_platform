# =============================================================================
# REQUIRED CONFIGURATION - MUST SET THESE VALUES
# =============================================================================

# Telegram Bot Token
# Get your bot token from @BotFather (https://t.me/botfather)
# Required: Yes
TELEGRAM_BOT_TOKEN=

# LLM API Key
# Required for ingredient analysis feature
# For OpenRouter: get from https://openrouter.ai/settings/keys
# For Gemini: get from https://aistudio.google.com/app/apikey
# Required: Yes
LLM_API_KEY=

# Ingredient Analysis Channel ID
# The specific channel/group where ingredient analysis is enabled
# Format: negative integer, typically starts with -100
# How to get: Add @userinfobot to your channel and send a message
# Required: Yes
INGREDIENT_ANALYSIS_CHANNEL_ID=-1001234567890

# =============================================================================
# OPTIONAL CONFIGURATION - DEFAULT VALUES ARE FINE FOR MOST USERS
# =============================================================================

# Ingredient Analysis Topic ID (Optional)
# The specific topic ID within the channel (for forum channels)
# Only used if INGREDIENT_ANALYSIS_CHANNEL_ID is set
# If not set, all topics in the channel will be processed
# Required: No
# INGREDIENT_ANALYSIS_TOPIC_ID=1

# OCR engine for ingredient photos: auto, paddle, glm, or qwen
# GLM is the default because it is more reliable for full-frame package photos.
# INGREDIENT_OCR_ENGINE=glm

# LLM Model (Optional)
# Model identifier format:
#   - OpenRouter: "openrouter/<provider>/<model>" (e.g., "openrouter/google/gemini-2.0-flash")
#   - Gemini: "gemini-<version>" (e.g., "gemini-2.0-flash")
# Default: gemini-3.6-flash
# LLM_MODEL=gemini-3.6-flash
#
# Examples:
#   LLM_MODEL=gemini-3.6-flash
#   LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet

# LLM Temperature (Optional)
# Range: 0.0 to 1.0
# Lower = more deterministic, Higher = more creative
# Default: 0.7
# LLM_TEMPERATURE=0.7

# LLM Max Tokens (Optional)
# Default: 4096
# LLM_MAX_TOKENS=4096

# =============================================================================
# SERVICE URLS - ONLY CHANGE IF SERVICES RUN ON DIFFERENT HOSTS/PORTS
# =============================================================================

# ASR Service URL
# URL of the local ASR (Automatic Speech Recognition) service
# Typeless stable API base URL. The bot appends /v1/audio/transcriptions.
# Local default: http://127.0.0.1:28111
# Docker default: http://host.docker.internal:28111 (set by docker-compose.yml)
# ASR_SERVICE_URL=http://127.0.0.1:28111
# Optional API key when TYPELESS_REQUIRE_AUTH=true on Typeless.
# TYPELESS_API_KEY=

# OCR Service Configuration
# URL of the local OCR (Optical Character Recognition) service
# Default for local development: http://127.0.0.1:18100
# Docker Compose overrides this with http://host.docker.internal:18100
# OCR_SERVICE_URL=http://127.0.0.1:18100

# OCR Max Concurrent Requests (Optional)
# Maximum number of concurrent OCR requests to prevent overloading
# Default: 4
# OCR_MAX_CONCURRENT=4

# OCR request timeout in seconds; large PDFs may need several minutes
# OCR_REQUEST_TIMEOUT_SECONDS=900

# Maximum Telegram image/PDF size accepted by the bot
# OCR_MAX_FILE_SIZE_MB=20

# Default engine: auto, paddle, glm, or qwen
# Applies to the dedicated generic OCR frontend, not ingredient analysis.
# OCR_DEFAULT_ENGINE=auto

# Dedicated OCR frontend destination (Optional)
# When OCR_CHANNEL_ID is set, image/PDF OCR only runs in that channel or group.
# Add OCR_TOPIC_ID to restrict it further to one forum topic.
# OCR_CHANNEL_ID=-1001234567890
# OCR_TOPIC_ID=1

# =============================================================================
# VOICE MESSAGE CONFIGURATION (Optional)
# =============================================================================

# Allowed Group IDs for Voice Messages
# List of group IDs to monitor for voice messages
# Format: JSON array of integers (group IDs are typically negative)
# Example: ALLOWED_GROUP_IDS=[-1001234567890,-1009876543210]
# If empty or not set, all voice messages will be processed
# ALLOWED_GROUP_IDS=[]

# =============================================================================
# RELIABLE MESSAGE PROCESSING (Optional)
# =============================================================================

# Every Telegram update is durably recorded before it is processed. Keep this path
# on persistent storage; Docker Compose mounts ./data at /app/data by default.
# UPDATE_STORE_PATH=/app/data/inbox.db

# Concurrent durable workers. Default: 2
# UPDATE_WORKER_COUNT=2

# =============================================================================
# DOCKER DEPLOYMENT NOTES
# =============================================================================
#
# If running services in Docker, use these URL formats:
#
# ASR Service:
#   - If on host machine: http://host.docker.internal:28111
#   - If in Docker: http://asr-service:28111
#
# OCR Service:
#   - If on host machine: http://host.docker.internal:18100
#   - If in Docker: http://ocr-service:8100
#
# The docker-compose.yml already includes extra_hosts mapping for compatibility.
#
# =============================================================================
# QUICK START
# =============================================================================
#
# 1. Set the REQUIRED values above
# 2. Build: make build
# 3. Run: make up
# 4. View logs: make logs
#
